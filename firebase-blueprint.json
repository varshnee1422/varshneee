{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "A bridal academy training course with curriculum, duration, fee structure, and batch availability.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["makeup", "hair", "draping", "nails", "skincare"] },
        "level": { "type": "string", "enum": ["Foundation", "Pro Mastery", "Masterclass"] },
        "durationWeeks": { "type": "number" },
        "totalHours": { "type": "number" },
        "feeAmount": { "type": "number" },
        "kitIncluded": { "type": "boolean" },
        "kitValue": { "type": "number" },
        "certification": { "type": "string", "minLength": 2, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 400 },
        "modules": { "type": "array", "description": "Curriculum modules covered in the course (1 to 12 items)." },
        "nextBatchDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "seatsAvailable": { "type": "number" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "level",
        "durationWeeks",
        "totalHours",
        "feeAmount",
        "kitIncluded",
        "kitValue",
        "certification",
        "imageUrl",
        "summary",
        "modules",
        "nextBatchDate",
        "seatsAvailable",
        "sortOrder",
        "updatedAt"
      ]
    },
    "ComboPackage": {
      "title": "ComboPackage",
      "description": "A bundled multi-skill bridal academy combo package with discounted fees and installment options.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "tagline": { "type": "string", "minLength": 4, "maxLength": 160 },
        "includedCourseTitles": { "type": "array", "description": "Included courses (1 to 8 items)." },
        "durationWeeks": { "type": "number" },
        "regularFee": { "type": "number" },
        "comboFee": { "type": "number" },
        "installmentMonths": { "type": "number" },
        "perks": { "type": "array", "description": "Key combo deliverables and kits (1 to 10 items)." },
        "isFeatured": { "type": "boolean" },
        "nextBatchDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "tagline",
        "includedCourseTitles",
        "durationWeeks",
        "regularFee",
        "comboFee",
        "installmentMonths",
        "perks",
        "isFeatured",
        "nextBatchDate",
        "sortOrder",
        "updatedAt"
      ]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "A student seat reservation, fee plan selection, or studio consultation booking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "programType": { "type": "string", "enum": ["course", "combo", "consultation"] },
        "programId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "programTitle": { "type": "string", "minLength": 2, "maxLength": 140 },
        "totalFee": { "type": "number" },
        "paymentPlan": { "type": "string", "enum": ["full", "emi_3", "emi_6", "consultation"] },
        "preferredBatch": { "type": "string", "minLength": 2, "maxLength": 60 },
        "experienceLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Working Artist"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "studentName",
        "email",
        "phone",
        "programType",
        "programId",
        "programTitle",
        "totalFee",
        "paymentPlan",
        "preferredBatch",
        "experienceLevel",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit admin allowlist entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 120 },
        "role": { "type": "string", "enum": ["director", "admissions"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Publicly readable bridal academy courses; writable only by verified admins."
    },
    "/combos/{comboId}": {
      "schema": { "$ref": "#/entities/ComboPackage" },
      "description": "Publicly readable bundled combo packages; writable only by verified admins."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student seat reservations and studio consultations isolated per owner or admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Academy directors and admissions admins."
    }
  }
}
